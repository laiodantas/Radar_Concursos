DATABASE_URL="postgresql://radar:radar@localhost:5432/radar?schema=public"
# Conexão direta usada pelas migrações (schema.prisma: directUrl). No Neon, use a URL sem pooler.
DIRECT_URL="postgresql://radar:radar@localhost:5432/radar?schema=public"
# "demo" mantém os dados sintéticos sinalizados. Troque para "pci" após validar o MCP.
RADAR_SOURCE="demo"
PCI_MCP_URL="https://mcp.pciconcursos.com.br/mcp"
# Segredo aleatório exigido pela rota POST /api/admin/sync
SYNC_SECRET="substitua-por-um-segredo-longo-e-aleatorio"
SYNC_TIMEOUT_MS="20000"
SYNC_MAX_RETRIES="2"
# Opcional: consultas próprias ao MCP (JSON com [{ "tool", "arguments" }]). Sem ela, usa listar_concursos.
# PCI_QUERIES_JSON='[{"tool":"pesquisar_concursos","arguments":{"termo":"analista","uf":"sp"}}]'
PCI_DEBUG=""
TZ="America/Sao_Paulo"
